{
  "schema_version": 1,
  "purpose": "The canonical routing contract for the repository's 21 Skills. Each intent has one primary Skill; a boundary describes the nearest route that must not be selected.",
  "groups": [
    {"id": "development-operations", "label": "開発運用", "description": "Issue、docs、実装、GitとWorkflowの計画・検証"},
    {"id": "obsidian-cli", "label": "Obsidian CLI", "description": "公式desktop CLIで行うvault・runtime操作"},
    {"id": "project-memory", "label": "Project memory", "description": "Obsidianへ保存する作業記憶の作成・復元・設定"}
  ],
  "skills": [
    {"name": "docs-review", "group": "development-operations", "intent": "Issueに対するdocsレビュー", "inputs": ["Issue", "docs", "Task scope"], "outputs": ["重大度付きreview"], "side_effect": "read-only", "manifest": "required", "invocation": "implicit", "implicit_exception": null, "primary_for": "実装前に仕様・設計docsの不足をレビューする", "boundary": "docsを新規作成・編集する依頼はdocs-authorまたは通常の編集へ"},
    {"name": "document-search", "group": "development-operations", "intent": "Markdown仕様のBM25検索", "inputs": ["query", "Markdown roots"], "outputs": ["順位付きファイル一覧"], "side_effect": "read-only", "manifest": "none", "invocation": "implicit", "implicit_exception": null, "primary_for": "関連docsやSkill指示を広く発見する", "boundary": "TOML Agent定義と実装コードはrg等で直接検索する"},
    {"name": "gitflow-branching", "group": "development-operations", "intent": "GitFlow branch/worktree操作", "inputs": ["branch operation", "Issue number", "repository state"], "outputs": ["branch/worktreeまたは操作計画"], "side_effect": "repository-git-write", "manifest": "required", "invocation": "explicit-only", "implicit_exception": null, "primary_for": "branch、worktree、release、hotfixを計画・実行する", "boundary": "Issue/PR本文の作成と通常の実装作業はissue-to-pr-workflowへ"},
    {"name": "implementation-finder", "group": "development-operations", "intent": "類似実装の探索と選択肢提示", "inputs": ["job specification", "local workspaces"], "outputs": ["比較、推奨、未解決事項"], "side_effect": "project-memory-write", "manifest": "required", "invocation": "explicit-only", "implicit_exception": null, "primary_for": "実装開始前にローカルの先行例から方針を決める", "boundary": "実装差分の妥当性確認はimplementation-reviewへ"},
    {"name": "implementation-review", "group": "development-operations", "intent": "実装差分のreview", "inputs": ["Issue", "docs", "diff", "test results"], "outputs": ["重大度付きreview"], "side_effect": "read-only", "manifest": "required", "invocation": "implicit", "implicit_exception": null, "primary_for": "commitまたはPR前後に実装・設定・テストをレビューする", "boundary": "Issue本文の準備はissue-review、docsのみはdocs-reviewへ"},
    {"name": "issue-review", "group": "development-operations", "intent": "Issue実装可能性のreview", "inputs": ["Issue", "impact scope", "dependencies"], "outputs": ["重大度付きreview"], "side_effect": "read-only", "manifest": "required", "invocation": "implicit", "implicit_exception": null, "primary_for": "branch前にIssueのscopeと完了条件を確認する", "boundary": "実装済み差分のreviewはimplementation-reviewへ"},
    {"name": "issue-to-pr-workflow", "group": "development-operations", "intent": "IssueからPRまでの実行契約", "inputs": ["user request", "Issue/Task plan"], "outputs": ["Issue、worktree、implementation、PRの進行記録"], "side_effect": "external-github-and-git", "manifest": "required", "invocation": "implicit", "implicit_exception": "T50所有の暫定例外。外部操作はAGENTS.mdの親Agent所有・実行時承認で制御し、T50でWorkflow実行契約を再設計する。", "primary_for": "複数ゲートを含む開発ライフサイクルを所有する", "boundary": "Workflow契約の監査はissue-to-pr-workflow-reviewへ"},
    {"name": "issue-to-pr-workflow-review", "group": "development-operations", "intent": "Workflow契約の監査", "inputs": ["Workflow assets", "task plan", "validation evidence"], "outputs": ["契約reviewとscenario結果"], "side_effect": "read-only", "manifest": "required", "invocation": "implicit", "implicit_exception": null, "primary_for": "Workflow変更または並列開発計画を監査する", "boundary": "個別Issueの実装可能性だけはissue-reviewへ"},
    {"name": "obsidian-official-cli", "group": "obsidian-cli", "intent": "local vault note/metadata操作", "inputs": ["official CLI request", "vault", "exact path when mutating"], "outputs": ["command result and affected files"], "side_effect": "vault-write", "manifest": "required", "invocation": "explicit-only", "implicit_exception": null, "primary_for": "公式CLIでnote、task、property、template、historyを扱う", "boundary": "runtime、Sync/Publish、workspace、devtoolsは専用Skillへ"},
    {"name": "obsidian-cli-bases-and-bookmarks", "group": "obsidian-cli", "intent": "Bases/Bookmarks操作", "inputs": ["base or bookmark request", "vault"], "outputs": ["query result or mutation summary"], "side_effect": "vault-write", "manifest": "required", "invocation": "explicit-only", "implicit_exception": null, "primary_for": "Bases query/itemとbookmarkを公式CLIで扱う", "boundary": "一般note CRUDはobsidian-official-cliへ"},
    {"name": "obsidian-cli-devtools", "group": "obsidian-cli", "intent": "Obsidian runtime診断", "inputs": ["diagnostic request", "explicit eval/CDP intent if needed"], "outputs": ["diagnostic evidence"], "side_effect": "runtime-write", "manifest": "required", "invocation": "explicit-only", "implicit_exception": null, "primary_for": "console、DOM/CSS、screenshot、CDP、evalを診断する", "boundary": "plugin/themeの管理はobsidian-cli-runtime-adminへ"},
    {"name": "obsidian-cli-runtime-admin", "group": "obsidian-cli", "intent": "Obsidian runtime管理", "inputs": ["plugin/theme/snippet/command request"], "outputs": ["runtime inventory or mutation summary"], "side_effect": "runtime-write", "manifest": "required", "invocation": "explicit-only", "implicit_exception": null, "primary_for": "plugins、themes、snippets、commands、hotkeysを管理する", "boundary": "runtime debuggingはobsidian-cli-devtoolsへ"},
    {"name": "obsidian-cli-sync-and-publish", "group": "obsidian-cli", "intent": "Sync/Publish操作", "inputs": ["Sync or Publish request", "capability probe"], "outputs": ["status or remote side-effect summary"], "side_effect": "remote-write", "manifest": "required", "invocation": "explicit-only", "implicit_exception": null, "primary_for": "Syncとcapability-gated Publishを扱う", "boundary": "local note editingはobsidian-official-cliへ"},
    {"name": "obsidian-cli-workflows", "group": "obsidian-cli", "intent": "named Obsidian workflow orchestration", "inputs": ["registered workflow_id", "preview/apply mode"], "outputs": ["plan or execution summary"], "side_effect": "delegated-vault-or-remote-write", "manifest": "required", "invocation": "explicit-only", "implicit_exception": null, "primary_for": "登録済みの複数ステップworkflowをpreview/applyで実行する", "boundary": "raw CLI commandは各domain Skillへ"},
    {"name": "obsidian-cli-workspace-and-navigation", "group": "obsidian-cli", "intent": "workspace/navigation操作", "inputs": ["workspace, vault, tab, or navigation request"], "outputs": ["state result or mutation summary"], "side_effect": "workspace-write", "manifest": "required", "invocation": "explicit-only", "implicit_exception": null, "primary_for": "workspace、tabs、vault listing、navigation utilityを扱う", "boundary": "note CRUDはobsidian-official-cliへ"},
    {"name": "project-autojournal", "group": "project-memory", "intent": "複数workstreamの自動checkpoint", "inputs": ["recent agent/repository evidence", "project-memory configuration"], "outputs": ["checkpoint notes and state"], "side_effect": "project-memory-write", "manifest": "required", "invocation": "explicit-only", "implicit_exception": null, "primary_for": "scheduledまたは明示的auto-journalで全候補を保存する", "boundary": "単一の手動handoffはsave-work-checkpointへ"},
    {"name": "project-completed-summary", "group": "project-memory", "intent": "完了作業のsummary保存", "inputs": ["completed workspace/session evidence"], "outputs": ["one completed-summary note"], "side_effect": "project-memory-write", "manifest": "required", "invocation": "explicit-only", "implicit_exception": null, "primary_for": "完了した作業を一件の耐久性あるsummaryへ保存する", "boundary": "進行中の手渡しはsave-work-checkpointへ"},
    {"name": "resume-project-context", "group": "project-memory", "intent": "作業文脈の復元", "inputs": ["project identity", "Obsidian notes", "current workspace evidence"], "outputs": ["concise resume summary"], "side_effect": "read-only", "manifest": "required", "invocation": "implicit", "implicit_exception": null, "primary_for": "中断した作業の現在地と次の行動を復元する", "boundary": "新しい記憶noteの作成はsave-work-checkpointまたはproject-completed-summaryへ"},
    {"name": "retro-summary", "group": "project-memory", "intent": "過去作業の遡及summary", "inputs": ["historic project clue", "prior agent threads", "repository evidence"], "outputs": ["historical completed-summary notes"], "side_effect": "project-memory-write", "manifest": "required", "invocation": "explicit-only", "implicit_exception": null, "primary_for": "既存memory以前の過去作業を復元して保存する", "boundary": "現在完了した作業はproject-completed-summaryへ"},
    {"name": "save-work-checkpoint", "group": "project-memory", "intent": "進行中作業のcheckpoint", "inputs": ["current thread", "workspace state"], "outputs": ["one checkpoint note"], "side_effect": "project-memory-write", "manifest": "required", "invocation": "explicit-only", "implicit_exception": null, "primary_for": "進行中作業を再開可能なhandoff noteに保存する", "boundary": "完了作業はproject-completed-summaryへ、複数候補の自動処理はproject-autojournalへ"},
    {"name": "setup-obsidian-work-skills", "group": "project-memory", "intent": "project-memory環境設定", "inputs": ["vault path", "repository roots", "agent sources"], "outputs": ["verified local config"], "side_effect": "local-config-write", "manifest": "required", "invocation": "explicit-only", "implicit_exception": null, "primary_for": "Obsidian project-memoryの初期設定や設定変更を行う", "boundary": "note作成や既存作業の要約はproject-memory Skillへ"}
  ],
  "prompts": [
